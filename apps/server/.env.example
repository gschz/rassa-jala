# RassaJala API — copia este archivo a .env y ajusta los valores.
# El esquema de validación vive en .env.schema (varlock); regenera tipos con: bun run env:generate

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma (la PWA en dev corre en :3001)
CORS_ORIGIN=http://localhost:3001

# PostgreSQL local (fuente de verdad). Crea la base antes de arrancar.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/rassa_jala

# Secretos JWT — mínimo 32 caracteres. Genera con: openssl rand -hex 32
JWT_ACCESS_SECRET=reemplaza-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=reemplaza-esto-por-otro-secreto-de-al-menos-32-caracteres

# Adaptador de binarios (imágenes, adjuntos): local (disco, default dev) | supabase
STORAGE_DRIVER=local

# Carpeta raíz del driver local; vacío = <raíz del repo>/storage
STORAGE_LOCAL_DIR=

# Solo si STORAGE_DRIVER=supabase. La service-role key es BACKEND-ONLY:
# nunca se empaqueta ni se envía al cliente.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
