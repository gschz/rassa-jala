{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@rassa-jala/api": "workspace:*",
    "@rassa-jala/db": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "^4.10.7",
    "jose": "^6.2.17",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rassa-jala/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
