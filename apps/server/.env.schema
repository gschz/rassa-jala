# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=32)
JWT_ACCESS_SECRET=

# @type=string(minLength=32)
JWT_REFRESH_SECRET=

# D-1 storage adapter: 'local' (dev disk) now; 'supabase' reserved for the final
# integration (the Supabase driver is a stub until then). Not a secret (driver
# selection), and public avoids varlock leak-scanner false positives on the literal
# "local" (substring of @rassa.local emails in responses).
# @public @type=enum(local, supabase)
STORAGE_DRIVER=

# Local driver root directory; empty = <repoRoot>/storage (resolved in code).
# @required=false
STORAGE_LOCAL_DIR=
