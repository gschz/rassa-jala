# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=32)
JWT_ACCESS_SECRET=

# @type=string(minLength=32)
JWT_REFRESH_SECRET=

# D-1 storage adapter: 'local' (dev disk) is the default; 'supabase' selects the
# Supabase Storage driver (private bucket + short-lived signed URLs, P0-C).
# Not a secret (driver selection), and public avoids varlock leak-scanner false
# positives on the literal "local" (substring of @rassa.local emails in responses).
# @public @type=enum(local, supabase)
STORAGE_DRIVER=

# Local driver root directory; empty = <repoRoot>/storage (resolved in code).
# @required=false
STORAGE_LOCAL_DIR=

# Supabase Storage (P0-C / D-1). Test-environment credentials (user decision
# 2026-11-21): the Supabase DB is a TEST env, leak-tolerant per the user, but the
# secret key stays backend-only regardless (service role, never to the client).
# Empty is valid while STORAGE_DRIVER=local (dev default).
# @required=false
SUPABASE_URL=

# Service-role key: backend ONLY — never shipped to the client, never logged.
# @required=false
SUPABASE_SECRET_KEY=

# Publishable key: kept for completeness; the client never talks to Supabase
# directly today (all access goes through the backend, architecture.md §7).
# @required=false
SUPABASE_PUBLISHABLE_KEY=
