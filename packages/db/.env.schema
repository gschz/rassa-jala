# Supabase TEST-environment Postgres: used ONLY by the sync script
# (sincronizar-supabase.ts). The dev DATABASE_URL above
# stays the local rassa_jala_db_v2 and is never pointed at Supabase. The URL
# needs sslmode=require for external connections; TimeZone=UTC is enforced by
# conSesionUtc (src/index.ts) on every Prisma connection — the URL param would
# only be belt-and-suspenders.
# @required=false
SUPABASE_DATABASE_URL=
