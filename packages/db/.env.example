# Prisma — copia este archivo a .env y ajusta los valores.
# El esquema vive en .env.schema (varlock; importa NODE_ENV/DATABASE_* de apps/server).

# PostgreSQL local que usa Prisma (db:push, db:migrate, db:generate).
# Debe apuntar a la MISMA base que apps/server.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/rassa_jala

# Opcional: solo lo consume packages/db/scripts/sincronizar-supabase.ts
# (espejo hacia un PostgreSQL remoto). Requiere sslmode=require.
SUPABASE_DATABASE_URL=
