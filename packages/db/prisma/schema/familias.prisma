// Familias domain — normative sources: docs/database.md §3.1 (familia, familia_usuario,
// limite_cliente→limite_credito, conversacion, integrantes rows), §4.2 (partial uniques),
// §5.2 (Prisma-inexpressible constraints live as migration SQL snippets), §7.1 M-8/M-9 and
// docs/scope.md §3.2 decisions Q-10 (limite_credito: exactly one owner familia|usuario) and
// Q-21 (one active membership per user, enforced by partial unique + server transaction).
//
// M-9: UUID PKs + legacy_id (M-3 adoption), estado/version/actualizado_en/creado_en
// (M-1b adoption) on every synced row. The partial unique indexes and CHECK constraints
// are added as raw SQL in the migration (Prisma cannot express them — database.md §5.2).

model Familia {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?     @unique @map("legacy_id")
  nombre        String
  // Jefe de familia: SetNull preserves the familia row and its audit trail when the
  // jefe usuario is deleted (legacy ORM policy, DA §3).
  fkJefeUsuario String?  @map("fk_jefe_usuario") @db.Uuid
  estado        Boolean  @default(true)
  version       Int      @default(1)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  jefe          Usuario? @relation("FamiliaJefe", fields: [fkJefeUsuario], references: [id], onDelete: SetNull)
  membresias    FamiliaUsuario[]
  limites       LimiteCredito[]
  conversaciones Conversacion[]

  @@index([fkJefeUsuario])
  @@map("familia")
}

// Q-21: at most ONE ACTIVE membership per user — enforced by the partial unique index
// "familia_usuario_fk_usuario_activo_key" (WHERE estado = true) created in the migration.
// Reactivated historical rows (estado=false → true) are the restore path; the index makes
// a double-active state impossible at the DB level (concurrent-safe).
model FamiliaUsuario {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?     @unique @map("legacy_id")
  fkUsuario     String   @map("fk_usuario") @db.Uuid
  fkFamilia     String   @map("fk_familia") @db.Uuid
  estado        Boolean  @default(true)
  version       Int      @default(1)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  usuario       Usuario  @relation(fields: [fkUsuario], references: [id], onDelete: Cascade)
  familia       Familia  @relation(fields: [fkFamilia], references: [id], onDelete: Cascade)

  @@index([fkUsuario])
  @@index([fkFamilia])
  @@map("familia_usuario")
}

// M-8 (Q-10): credit limit with EXACTLY ONE owner — fk_familia XOR fk_usuario, enforced by
// the "limite_credito_propietario_unico" CHECK plus the two partial unique indexes (one row
// per owner, any estado). monto CHECK >= 0 (F-05 family: server-last-guarantor; M-2).
// Replaces the legacy 1:1 limite_cliente concept; import maps legacy rows to fk_usuario.
model LimiteCredito {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  monto         Decimal   @db.Decimal(12, 2)
  fkFamilia     String?   @map("fk_familia") @db.Uuid
  fkUsuario     String?   @map("fk_usuario") @db.Uuid
  estado        Boolean   @default(true)
  version       Int       @default(1)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  familia       Familia?  @relation(fields: [fkFamilia], references: [id], onDelete: SetNull)
  usuario       Usuario?  @relation(fields: [fkUsuario], references: [id], onDelete: SetNull)

  @@index([fkFamilia])
  @@index([fkUsuario])
  @@map("limite_credito")
}

// Family-chat record (database.md §3.1 conversacion row): minimal integration so a family
// always has its group conversation. No mensaje model yet (chat module is P1). The partial
// unique "conversacion_fk_familia_activa_key" (WHERE estado AND fk_familia IS NOT NULL)
// keeps at most one ACTIVE conversation per family (legacy parity, §4.2).
model Conversacion {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fkFamilia     String?     @map("fk_familia") @db.Uuid
  // tipo mirrors legacy semantics: false = privada, true = grupal.
  tipo          Boolean
  // T6 (gap-pass-9) §7.21 manual groups: legacy Conversacion.nombre
  // (CharField(100), nullable) — set ONLY for manual groups; family chats keep
  // projecting familia.nombre (renaming a family chat stays family-administered).
  nombre        String?     @db.VarChar(100)
  estado        Boolean     @default(true)
  version       Int         @default(1)
  actualizadoEn DateTime    @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  creadoEn      DateTime    @default(now()) @map("creado_en") @db.Timestamptz(6)
  familia       Familia?    @relation(fields: [fkFamilia], references: [id], onDelete: SetNull)
  integrantes   Integrante[]
  // P1-D Chat (M-18): the conversation timeline (cascade = legacy mensaje.fk_conversacion).
  mensajes      Mensaje[]

  @@index([fkFamilia])
  @@map("conversacion")
}

// Conversation membership (database.md §3.1 integrantes row): UNIQUE (fk_usuario,
// fk_conversacion) + rol domain CHECK ('admin'|'miembro') in the migration (M-4). No
// estado/soft-delete: removal deletes the row (reversible by re-insert); chat sync is P1.
model Integrante {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fkConversacion String       @map("fk_conversacion") @db.Uuid
  fkUsuario      String       @map("fk_usuario") @db.Uuid
  rol            String       @default("miembro")
  creadoEn       DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)
  conversacion   Conversacion @relation(fields: [fkConversacion], references: [id], onDelete: Cascade)
  usuario        Usuario      @relation(fields: [fkUsuario], references: [id], onDelete: Cascade)

  @@unique([fkUsuario, fkConversacion])
  @@index([fkConversacion])
  @@index([fkUsuario])
  @@map("integrantes")
}
