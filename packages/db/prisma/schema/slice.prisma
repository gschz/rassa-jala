// Vertical slice models — normative sources: docs/database.md (§3 inventory, §5.3 P-1 IDs,
// §7.1 M-1a/M-1b/M-3, §6.2 collection map) and docs/synchronization.md (§5.2 SP-2, §7 SP-3).
//
// slice-decision: varchar lengths are not specified in database.md for these entities; text is used
// (no length constraints) — revisit when the column-by-column import from rassa_jala_db lands.

model Municipio {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?     @unique @map("legacy_id")
  nombre        String
  estado        Boolean  @default(true)
  version       Int      @default(1)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  localidades   Localidad[]

  @@map("municipio")
}

model Localidad {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?      @unique @map("legacy_id")
  fkMunicipio   String    @map("fk_municipio") @db.Uuid
  nombre        String
  estado        Boolean   @default(true)
  version       Int       @default(1)
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  municipio     Municipio @relation(fields: [fkMunicipio], references: [id], onDelete: Cascade)
  personas      Persona[]

  @@index([fkMunicipio])
  @@map("localidad")
}

model CategoriaProducto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?     @unique @map("legacy_id")
  nombre        String
  estado        Boolean  @default(true)
  version       Int      @default(1)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  productos     Producto[]

  @@map("categoria_producto")
}

model Unidad {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?     @unique @map("legacy_id")
  tipo          String?
  nombre        String?
  abreviatura   String?
  estado        Boolean  @default(true)
  version       Int      @default(1)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  productos     Producto[]
  productosSemanales ProductoSemanal[]

  @@map("unidad")
}

// M-1a — transactional outbox: append-only, written in the same tx as every business mutation.
// PULL checkpoint source (synchronization.md §4).
model SyncCambio {
  id          BigInt   @id @default(autoincrement())
  tablaOrigen String   @map("tabla_origen")
  idFila      String   @map("id_fila") @db.Uuid
  operacion   String
  // Actor is a logical reference with no hard FK (M-1a item 6); since the P0 auth module it
  // carries the authenticated Usuario id (UUID string), replacing the slice dev stub.
  actor       String?
  creadoEn    DateTime @map("creado_en") @default(now()) @db.Timestamptz(6)

  @@index([tablaOrigen, id])
  @@map("sync_cambio")
}

// SP-3 — push idempotency registry: PK is the client operationId; written in the same tx as the
// effect (synchronization.md §7).
model SyncOperacion {
  id        String   @id @db.Uuid
  // Logical reference to the authenticated Usuario (no hard FK, same rationale as
  // SyncCambio.actor); carries the real user id since the P0 auth module.
  fkUsuario String   @map("fk_usuario")
  coleccion String
  docId     String   @map("doc_id") @db.Uuid
  op        String
  veredicto String
  respuesta Json?
  creadoEn  DateTime @map("creado_en") @default(now()) @db.Timestamptz(6)

  @@map("sync_operacion")
}
