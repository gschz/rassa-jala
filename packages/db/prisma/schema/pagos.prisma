// Pagos domain — normative sources: docs/database.md M-13 (pago, recibo, tipo_pago, folio_secuencia),
// docs/scope.md §3.1 (F-05 monto snapshot == pedido.total; F-06 1 pago per pedido via UNIQUE fk_pedido;
// F-07 folio serialization; recibo 1:1 snapshot; credit released on payment Q-10).

model TipoPago {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?     @unique @map("legacy_id")
  nombre        String   @unique
  estado        Boolean  @default(true)
  version       Int      @default(1)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  pagos         Pago[]

  @@map("tipo_pago")
}

model Pago {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?           @unique @map("legacy_id")
  fkPedido      String         @unique @map("fk_pedido") @db.Uuid
  fkTipoPago    String         @map("fk_tipo_pago") @db.Uuid
  folio         String         @unique
  monto         Decimal        @db.Decimal(12, 2)
  referencia    String?
  actor         String?        @db.Uuid
  estado        Boolean        @default(true)
  version       Int            @default(1)
  actualizadoEn DateTime       @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  creadoEn      DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)
  pedido        PedidoCabecera @relation(fields: [fkPedido], references: [id], onDelete: Restrict)
  tipoPago      TipoPago       @relation(fields: [fkTipoPago], references: [id], onDelete: Restrict)
  recibo        Recibo?

  @@index([fkTipoPago])
  @@index([creadoEn])
  @@map("pago")
}

model Recibo {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId      Int?     @unique @map("legacy_id")
  fkPago        String   @unique @map("fk_pago") @db.Uuid
  folio         String   @unique
  datos         Json
  emitidoEn     DateTime @default(now()) @map("emitido_en") @db.Timestamptz(6)
  estado        Boolean  @default(true)
  version       Int      @default(1)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  pago          Pago     @relation(fields: [fkPago], references: [id], onDelete: Restrict)

  @@index([emitidoEn])
  @@map("recibo")
}

model FolioSecuencia {
  nombre    String @id
  siguiente Int    @default(1)

  @@map("folio_secuencia")
}
